# Firebase configuration
# Copy this file to .env and fill in your Firebase project values
# Get these from: Firebase Console > Project Settings > Your apps > Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Groq API — used server-side by the document extraction agent
# Get your key from: https://console.groq.com/keys
# No VITE_ prefix = never bundled into client code
GROQ_API_KEY=your_groq_api_key_here

# Upstash Redis — used server-side for quote caching
# No VITE_ prefix = never bundled into client code
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Polygon/Massive — used server-side for normal US stock quotes
# No VITE_ prefix = never bundled into client code
POLYGON_API_KEY=your_polygon_api_key_here
# Optional override; defaults to https://api.massive.com
POLYGON_API_BASE_URL=https://api.massive.com

# Optional quote cache controls
QUOTE_CACHE_TTL_SECONDS=300
QUOTE_CACHE_RETENTION_SECONDS=86400
QUOTE_REFRESH_CONCURRENCY=5
QUOTE_REFRESH_LIMIT=100
CRON_SECRET=change_me_for_scheduled_refresh_endpoint

# Research pipeline credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── X read provider ───────────────────────────────────────────────────────────
# Which backend serves the nightly pipeline's X reads.
#   twitterapi.io  — ~$0.15 per 1k posts
#   x / official   — the official X API, ~$5 per 1k posts
# Leave blank to auto-select: twitterapi.io when its key is set and
# X_BEARER_TOKEN is not, otherwise the official API.
X_PROVIDER=

# twitterapi.io (pay-as-you-go credits; no subscription needed).
# Free accounts are capped at 0.2 QPS — set TWITTERAPI_IO_DELAY_MS=5200 to stay
# under it. Any paid credit raises the cap and the delay can go back to 0.
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_DELAY_MS=
TWITTERAPI_IO_MAX_PAGES=

# Official X API credentials
# Bearer token is enough for the tracked-account and recent-search reads used here.
# Access token + secret are only needed if you later add user-context endpoints.
X_API_KEY=
X_API_KEY_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Legacy Twitter/X scraping via browser session / unofficial client
# Not required when X_BEARER_TOKEN is configured.
# Preferred: session cookies from an already logged-in browser
TWITTER_COOKIES_JSON=
TWITTER_COOKIES_BASE64=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Fallback: username/password login (currently less reliable than cookies)
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
TWITTER_2FA_SECRET=
