# WallAI environment
#
# Copy to .env and fill in. Everything without a VITE_ prefix stays server-side
# and is never bundled into the client.
#
# The fastest way to see the app without any of this is preview mode, which
# needs no credentials at all:
#
#   VITE_MOCK_AUTH=true npx vite
#
# ── Firebase: required to run at all ─────────────────────────────────────────
# console.firebase.google.com → create a project → enable Authentication
# (Google) and Firestore → register a web app → copy the config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Connecting a brokerage ───────────────────────────────────────────────────
# PLAID_ENV is sandbox or production. Plaid retired `development`; anything
# else fails at startup with a message naming the setting.
#
# FIREBASE_SERVICE_ACCOUNT is how the serverless functions reach Firestore —
# the whole service-account JSON on one line, from Firebase Console → Project
# Settings → Service Accounts. Without it, connecting a brokerage cannot work.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
FIREBASE_SERVICE_ACCOUNT=

# ── Market data ──────────────────────────────────────────────────────────────
# Yahoo needs no key and is the fallback, the source for CDR (.NE) listings,
# and where the USD/CAD rate comes from. Polygon is preferred for US equities
# when a key is present. Without Redis every refresh calls providers directly.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POLYGON_API_KEY=
POLYGON_API_BASE_URL=
MASSIVE_API_KEY=
MASSIVE_API_BASE_URL=

# ── Research pipeline ────────────────────────────────────────────────────────
# GROQ_API_KEY also powers PDF statement extraction, so it is worth setting
# even if you never run research.
#
# X_PROVIDER selects the read path; X_BEARER_TOKEN is app-only read access to
# the official API, TWITTERAPI_IO_KEY the alternative.

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXA_API_KEY=
X_PROVIDER=
X_BEARER_TOKEN=
X_API_BASE_URL=
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE=

# Guards the scheduled endpoints (refresh-prices, nightly-research,
# track-performance). Requests without it are rejected.
CRON_SECRET=

# ── Slack (optional) ─────────────────────────────────────────────────────────

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# ── Tuning (all optional, defaults shown where they exist) ───────────────────

QUOTE_CACHE_TTL_SECONDS=300
QUOTE_CACHE_RETENTION_SECONDS=86400
QUOTE_REFRESH_CONCURRENCY=5
QUOTE_REFRESH_LIMIT=100
NEWS_MAX_AGE_HOURS=
RESEARCH_EFFORT=
SCREENER_MAX_PAGES=
TWITTERAPI_IO_DELAY_MS=
TWITTERAPI_IO_MAX_PAGES=

# Primary disclosure foundation. SEC requires an identifying User-Agent, and
# only disclosure ingestion needs it: without it the security master still
# publishes and nightly research still runs on attention, the run records a
# sec-client error, and the 20/60-session filing horizons stay empty.
SEC_USER_AGENT="Wallet research contact@example.com"
# Required. Stable common-stock IDs use the existing MASSIVE_API_KEY or
# POLYGON_API_KEY. Ticker resolution runs off this master, so with no master
# no source resolves a name and nightly research has nothing to review.
# A free Massive Basic key is enough: pagination is paced to five requests per
# minute and resumes across daily runs, and the published master is cached for
# 30 days rather than rebuilt every 36 hours.
# Original filing bytes live in a private S3-compatible bucket, not in Redis,
# which keeps only pointers, indexes and metadata. Cloudflare R2's free tier
# includes a Standard storage allowance; usage beyond it is billed. This adapter
# uses R2's region=auto signing (not arbitrary S3 endpoints). See
# docs/research/experimental-deployment.md for setup and legacy blob migration.
RESEARCH_R2_ENDPOINT=
RESEARCH_R2_BUCKET=
RESEARCH_R2_ACCESS_KEY_ID=
RESEARCH_R2_SECRET_ACCESS_KEY=
# Issuers whose filings are ingested per daily run. Default 5, the low-cost
# pilot rate. The daily SEC index enqueues every issuer that filed, so at 5 a
# day the backlog grows faster than it drains and the fundamentals stream stays
# empty; raise this to work it down, at the cost of more SEC requests.
RESEARCH_INGEST_MAX_ISSUERS=
# Exactly 30 unique-security review slots; these are exploration budgets.
RESEARCH_STREAM_BUDGETS='{"attention":12,"fundamentals":10,"filing_changes":5,"insider":3}'
