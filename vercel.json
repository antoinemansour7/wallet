{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/research-foundation",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/nightly-research",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/nightly-research",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/research-evaluation",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/track-performance",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/nightly-research.js": {
      "maxDuration": 300
    },
    "api/research-foundation.js": {
      "maxDuration": 300
    },
    "api/research-evaluation.js": {
      "maxDuration": 300
    },
    "api/track-performance.js": {
      "maxDuration": 300
    },
    "api/plaid.js": {
      "maxDuration": 300
    },
    "api/options-scan.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/get-research-history",
      "destination": "/api/get-research?history=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
