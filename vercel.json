{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/nightly-research",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/track-performance",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/nightly-research.js": {
      "maxDuration": 300
    },
    "api/plaid.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
