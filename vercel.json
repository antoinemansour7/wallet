{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/nightly-research.js": {
      "maxDuration": 300
    },
    "api/research-foundation.js": {
      "maxDuration": 300
    },
    "api/research-evaluation.js": {
      "maxDuration": 300
    },
    "api/track-performance.js": {
      "maxDuration": 300
    },
    "api/plaid.js": {
      "maxDuration": 300
    },
    "api/options-scan.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/get-research-history",
      "destination": "/api/get-research?history=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
