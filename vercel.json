{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/refresh-prices",    "schedule": "0 14 * * *" },
    { "path": "/api/nightly-research",  "schedule": "0 3 * * 0-5"  },
    { "path": "/api/track-performance", "schedule": "30 14 * * *" }
  ],
  "functions": {
    "api/nightly-research.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
