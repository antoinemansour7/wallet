{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/refresh-prices",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/nightly-research",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/nightly-research?mode=premarket",
      "schedule": "15 12 * * 1-5"
    },
    {
      "path": "/api/track-performance",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/research-foundation",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/nightly-research.js": {
      "maxDuration": 300
    },
    "api/research-foundation.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
